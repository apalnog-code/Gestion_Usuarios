{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/user.css') }}">
{% endblock %}

{% block body %}
    <div class="contenedor" style="width: 70%; margin: auto">
        <h1>Add users</h1>
        {{ form_start(form) }}
        {{ form_widget(form) }}
            <button type="submit" class="btn btn-success">Confirmar</button>
            <a href="{{ path('users_list') }}" class="btn btn-danger">Volver</a>
        {{ form_end(form) }}
    </div>
{% endblock %}


